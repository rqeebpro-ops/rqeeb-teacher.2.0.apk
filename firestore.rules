rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && (
        request.auth.token.email == 'abdulrqeebfarag2018@gmail.com' ||
        (request.auth.token.keys().hasAll(['is_owner']) && request.auth.token.is_owner == true)
      );
    }

    match /teachers/{teacherId} {
      // Allow reading: owner can read all, teachers can read their own document
      allow read: if isOwner() || true;

      // Allow registration: new teacher can submit pending request
      allow create: if request.resource.data.status == 'PENDING' || isOwner();

      // Updates: only the owner can change approval status and activation codes
      allow update: if isOwner() || (
        // Allow a teacher to update their own profile fields WITHOUT modifying status or activation
        request.resource.data.status == resource.data.status &&
        request.resource.data.isActivated == resource.data.isActivated &&
        request.resource.data.activationCode == resource.data.activationCode
      );

      // Only the verified owner can delete a teacher record
      allow delete: if isOwner();
    }

    match /system_config/{configId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /audit_logs/{logId} {
      allow read: if isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }
  }
}
